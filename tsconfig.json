{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],

    "outDir": "./dist",
    "rootDir": "./backend",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "./backend",
    "paths": {
      "@/*": ["./*"],
      "@services/*": ["./services/*"],
      "@security/*": ["./security/*"],
      "@monitoring/*": ["./monitoring/*"]
    }
  },

  "include": [
    "backend/**/*.ts",
    "backend/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "backups",
    "operations",
    "tests/e2e",
    "frontend"
  ]
}